# Overclock Arena game server. Installed by setup-vps.sh.
# Settings: /etc/overclock/overclock.env (then: sudo systemctl restart overclock)
[Unit]
Description=Overclock Arena game server
After=network.target
# Nothing to run until the first build has been installed.
ConditionPathExists=/opt/overclock/dist/server.js

[Service]
Type=simple
User=overclock
Group=overclock
WorkingDirectory=/opt/overclock
ExecStart=/usr/local/bin/bun /opt/overclock/dist/server.js
Restart=always
RestartSec=2

# Bound to localhost; nginx is the public face. If you change PORT, change nginx too.
Environment=HOST=127.0.0.1
Environment=PORT=8787
# Read the page through the dist symlink, so the build ID players are told about follows
# page-only updates (which don't restart the server).
Environment=INDEX_HTML=/opt/overclock/dist/index.html
EnvironmentFile=-/etc/overclock/overclock.env

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/overclock

[Install]
WantedBy=multi-user.target
